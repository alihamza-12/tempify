MONGODB_URI=mongodb://APP_USER:PASSWORD@127.0.0.1:27017/cuvva?authSource=admin
SHARED_INTEGRATION_OWNER_ID=000000000000000000000000
SESSION_SECRET=replace-with-a-long-random-secret
REGCHECK_USERNAMES=account_one,account_two
RESEND_API_KEY=re_xxxxxxxxx
# Separate API key for the delayed customer setup-guide email.
RESEND_GUIDE_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Cuvvafy <auto@cuvvapolicies.com>
PAYMENT_EMAIL_FROM=Cuvva <auto@cuvvapolicies.com>
CONTACT_TO_EMAIL=support@cuvvapolicies.com
# Use resend for explicit provider delivery. Legacy console value also routes by email
# when RESEND_API_KEY is configured; this app never returns/logs OTP codes.
EMAIL_DELIVERY_MODE=resend
# Must be an HTTPS origin. For local testing, use an HTTPS tunnel to localhost:3000.
NEXT_PUBLIC_APP_URL=https://replace-with-your-https-test-origin.example
# This build has no authorised live policy issuer. Keep live payments disabled.
LIVE_POLICY_CHECKOUT_ENABLED=false
# Use ONLY one matching test-mode Stripe key pair in local/Preview environments.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY
# Stripe CLI local webhook secret (or a Stripe test-mode webhook secret for Preview).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_TEST_WEBHOOK_SECRET
# In deployed Preview (NODE_ENV=production), explicitly opt in to test-mode checkout.
STRIPE_TEST_CHECKOUT_ENABLED=false
# Comma-separated addresses you control; test emails are sent for real by Resend.
STRIPE_TEST_ALLOWED_EMAILS=your-test-inbox@example.com
PAYMENT_CURRENCY=GBP
# PAYMEGATE_API_KEY=
# PAYMEGATE_WEBHOOK_SECRET=
# PAYMEGATE_BASE_URL=https://api.paymegate.com
