# Use the exact same local MongoDB database URI as Cuvva. Shared business data
# uses the same users and vehicles collections. Tempify support collections for
# OTPs, quotes and PayMeGate orders also live in this one database.
MONGODB_URI=mongodb://APP_USER:PASSWORD@127.0.0.1:27017/cuvva?authSource=admin
# Existing active Cuvva Super Admin ObjectId used as createdBy when Tempify
# inserts a newly provider-verified vehicle into the shared vehicles collection.
SHARED_INTEGRATION_OWNER_ID=000000000000000000000000

# Generate at least 32 random bytes. Never reuse a public example in production.
SESSION_SECRET=replace-with-a-long-random-secret

# RegCheck credentials stay server-side. Separate multiple usernames with commas.
REGCHECK_USERNAMES=account_one,account_two

# Resend: create a separate key for this project in the same verified account/domain.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Tempify <auto@cuvvapolicies.com>
# Destination for validated contact/support form messages.
CONTACT_TO_EMAIL=support@cuvvapolicies.com
# Use console locally to display OTPs and contact messages without sending email. Use resend in production.
EMAIL_DELIVERY_MODE=console

# Public production origin. PayMeGate requires a public HTTPS backUrl.
NEXT_PUBLIC_APP_URL=https://your-tempify-domain.example

# Keep false until written issuance authority is confirmed AND an approved
# insurer fulfilment module has been implemented. PayMeGate credentials alone
# are not enough; this build does not issue a legal insurance policy.
LIVE_POLICY_CHECKOUT_ENABLED=false
# PayMeGate values are added after merchant signup. Checkout also returns HTTP
# 503 until the authority gate above is enabled and a real API key is supplied.
PAYMEGATE_API_KEY=
PAYMEGATE_WEBHOOK_SECRET=
PAYMEGATE_BASE_URL=https://api.paymegate.com
PAYMENT_CURRENCY=GBP
